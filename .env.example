APP_NAME="API Laravel Template"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8080

# ---------------------------------------------------------------------------
# Docker Compose (lidas pelo compose.yaml, não pelo Laravel)
# ---------------------------------------------------------------------------
# Prefixo dos containers, da rede, dos volumes e da imagem. É o que distingue dois
# projetos criados a partir deste template rodando na mesma máquina.
COMPOSE_PROJECT_NAME=api-laravel-template
# Portas publicadas no host. Troque se já houver outro projeto usando as padrão
# (e ajuste APP_URL para a mesma porta de APP_PORT).
APP_PORT=8080
FORWARD_DB_PORT=3306
FORWARD_REDIS_PORT=6379
FORWARD_MAILPIT_PORT=8025
FORWARD_MAILPIT_SMTP_PORT=1025

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# Hostnames são nomes de serviço do Compose; os valores precisam bater com os defaults
# do compose.yaml. O banco de testes é sempre <DB_DATABASE>_test (ver phpunit.xml).
DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=app
DB_USERNAME=app
DB_PASSWORD=secret

# ---------------------------------------------------------------------------
# Autenticação (config/identity.php, docs/guide/02-autenticacao.md)
# ---------------------------------------------------------------------------
# Guard padrão: "api" = usuários externos (Passport). APIs internas usam "internal" (Sanctum).
AUTH_GUARD=api
# Usuários externos (Passport): vida do access token e do refresh token, em minutos.
AUTH_USER_TOKEN_TTL=5
AUTH_USER_REFRESH_TOKEN_TTL=10080
# APIs internas (Sanctum): vida do token de serviço, em minutos.
AUTH_SERVICE_TOKEN_TTL=60
# Chaves RSA do Passport. Em desenvolvimento ficam em storage/oauth-*.key (php artisan
# auth:install). Em produção, prefira injetar pelo ambiente em vez de arquivo:
# PASSPORT_PRIVATE_KEY=
# PASSPORT_PUBLIC_KEY=

# Base dos identificadores "type" dos erros (RFC 9457). Estável entre ambientes.
API_PROBLEM_TYPE_BASE=https://api.example.com/problems

# ---------------------------------------------------------------------------
# Limite de requisições (config/api.php; os limiters estão no AppServiceProvider)
# ---------------------------------------------------------------------------
# Por MINUTO: rotas de usuário (por usuário ou IP) e rotas internas (por cliente de serviço).
API_RATE_LIMIT=120
API_INTERNAL_RATE_LIMIT=600
# Por MINUTO: tentativas de login (por e-mail + IP) e pedidos de token (refresh e serviço).
API_LOGIN_RATE_LIMIT=5
API_TOKEN_RATE_LIMIT=30
# Por SEGUNDO: cadastros de usuário em /internal/auth/register, por cliente de serviço.
API_REGISTER_RATE_LIMIT=5

SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=redis

CACHE_STORE=redis
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="no-reply@example.test"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Concurrency::run: "process" abre processos PHP filhos com proc_open, que o pool do
# php-fpm desabilita de propósito (docker/php/php-fpm.d/www.conf, hardening). Em
# requisições web use "sync"; "process" funciona no CLI (artisan).
CONCURRENCY_DRIVER=sync
